<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:iconSpaceReserved="false">

    <PreferenceCategory
        android:title="@string/prefs_category_network"
        app:iconSpaceReserved="false">

        <EditTextPreference
            android:key="port"
            android:title="@string/prefs_port_title"
            android:defaultValue="8081"
            android:inputType="number"
            android:dialogTitle="@string/prefs_port_dialog"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/prefs_category_video"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="resolution"
            android:title="@string/prefs_resolution_title"
            android:entries="@array/resolution_entries"
            android:entryValues="@array/resolution_values"
            android:defaultValue="640x480"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:key="fps"
            android:title="@string/prefs_fps_title"
            android:entries="@array/fps_entries"
            android:entryValues="@array/fps_values"
            android:defaultValue="15"
            app:iconSpaceReserved="false" />

        <SeekBarPreference
            android:key="quality"
            android:title="@string/prefs_quality_title"
            android:max="100"
            android:defaultValue="80"
            app:min="10"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="autoFramesize"
            android:title="@string/prefs_autoframesize_title"
            android:summary="@string/prefs_autoframesize_summary"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/prefs_category_background"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="keepWarm"
            android:title="@string/prefs_keepwarm_title"
            android:summary="@string/prefs_keepwarm_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="autostart"
            android:title="@string/prefs_autostart_title"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="battery_opt"
            android:title="@string/battery_opt"
            android:summary="@string/prefs_battery_summary"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="oem_autostart"
            android:title="@string/prefs_oem_autostart_title"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
